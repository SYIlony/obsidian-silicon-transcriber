{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "CommonJS",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": false,
    "esModuleInterop": true,
    "isolatedModules": false,
    "strictNullChecks": true,
    "lib": ["DOM", "ES5", "ES6", "ES7"],
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "**/*.css"
  ]
}